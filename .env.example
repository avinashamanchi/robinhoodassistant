# This legacy environment-file format is accepted only by `ops.secrets migrate-env`
# and explicit test/development commands. Normal runtime uses a SecretProvider.
# Do not commit a populated .env file.

# LLM providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Market data
MARKETSTACK_API_KEY=

# Alpaca paper credentials
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Runtime and operator secrets
APP_API_TOKEN=
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CANDIDATE_SIGNING_KEY=
BACKUP_ENCRYPTION_KEY=

# JSON object mapping configured key IDs to independent Base64-encoded 32-byte
# values. This field is migration/test-only; do not use it for normal runtime.
FIELD_ENCRYPTION_KEYS_JSON=

# Legacy live-mode confirmation. Leave unset for paper-only operation.
LIVE_TRADING_CONFIRM=
