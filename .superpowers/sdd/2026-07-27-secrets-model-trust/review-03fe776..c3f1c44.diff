+        matched = original_match(descriptor_stat, path_stat, member)
+        if member.name == "encrypted.aesgcm" and matched:
+            encrypted_checks += 1
+            if encrypted_checks == 3:
+                replacement = transaction / member.name
+                original_unlink(replacement)
