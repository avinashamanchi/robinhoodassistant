+    recovery_now = time.time()
+    _age_tree(transaction, recovery_now - 120)
+    original_unlink = os.unlink
+    failed_once = False
+
+    def fail_one_member(path, *args, **kwargs):
+        nonlocal failed_once
+        if path == "snapshot.sqlite3" and not failed_once:
