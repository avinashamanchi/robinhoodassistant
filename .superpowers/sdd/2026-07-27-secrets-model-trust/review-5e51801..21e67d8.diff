+                        member,
+                        os.O_RDONLY,
+                    ),
+                )
+            )
+        if set(os.listdir(transaction.directory_descriptor)) != namespace:
+            raise EncryptedBackupError(
+                "encrypted_backup_transaction_invalid"
+            )
