+                path_stat,
+                member,
+            ):
+                raise EncryptedBackupError(
+                    "encrypted_backup_transaction_invalid"
+                )
+        return opened
+    except BaseException:
+        for _member, descriptor in opened:
+            os.close(descriptor)
+        raise
+
