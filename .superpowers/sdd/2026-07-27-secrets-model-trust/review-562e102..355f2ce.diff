+        "get_open_orders",
+        "get_order_status",
+        "list_rules",
+    }
+)
+_CHAT_DRAFT_METHODS = frozenset({"draft_order", "draft_rule"})
+_MUTATION_TOOL_TOKENS = frozenset(
+    {
+        "add",
+        "approve",
+        "cancel",
+        "commit",
+        "create",
+        "delete",
+        "execute",
