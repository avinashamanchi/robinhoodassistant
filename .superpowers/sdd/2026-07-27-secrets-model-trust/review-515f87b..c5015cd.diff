+
+    class SuccessfulLeaseRenewal:
+        def renew(self, *_args, **_kwargs):
+            return LeaseDecision(
+                acquired=True,
+                owner=hold.owner,
+                generation=hold.generation,
+                expires_at=renewed_expires_at,
+                retry_after_seconds=0,
+            )
+
+    def transient_receipt_store(
+        _app,
+        request_id,
+        generation,
