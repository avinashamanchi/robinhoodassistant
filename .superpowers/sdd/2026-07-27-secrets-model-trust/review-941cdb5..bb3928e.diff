+        calls.append(category)
+        return BudgetedLLMBackend(
+            ScriptedDelegate(_text_response(_summary_json())),
+            provider_budget,
+            provider="test",
+            category=category,
+            max_output_tokens=4_096,
+            estimator=Utf8ByteUpperBoundEstimator(),
