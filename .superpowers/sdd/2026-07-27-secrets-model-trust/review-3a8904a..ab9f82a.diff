+    UNSAFE_STATE_PRESENT = "unsafe_state_present"
+    UNCERTAIN_INTERLOCKS_CLEAR = "uncertain_interlocks_clear"
+    UNCERTAIN_INTERLOCKS_PRESENT = "uncertain_interlocks_present"
