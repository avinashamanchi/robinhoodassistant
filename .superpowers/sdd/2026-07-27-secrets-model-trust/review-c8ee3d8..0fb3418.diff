+        anchor_stat = _pending_anchor(path).lstat()
+        if not (
+            stat.S_ISREG(artifact_stat.st_mode)
+            and stat.S_ISREG(anchor_stat.st_mode)
+            and artifact_stat.st_dev == anchor_stat.st_dev
+            and artifact_stat.st_ino == anchor_stat.st_ino
+        ):
