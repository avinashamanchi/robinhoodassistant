+                    **_migration_kwargs(
+                        path,
+                        tmp_path / "migrate-backups",
+                        stage_hook=stop_after_backup,
+                    ),
+                )
+            else:
+                monkeypatch.setattr(
+                    module,
+                    "_state",
+                    lambda _engine: SimpleNamespace(
+                        state="complete",
+                        active_key_id=OLD_KEY_ID,
+                    ),
+                )
+                rotate_sensitive_fields(
+                    engine,
+                    old_cipher=SensitiveDataCipher(
